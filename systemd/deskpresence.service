[Unit]
Description=deskpresence: mmWave desk presence -> TV on/off
After=graphical-session.target

[Service]
ExecStart=%h/go/bin/deskpresence -near-gates 2 -energy-min 38 -absence 20s -fade 8s -max-distance 150 -hooks "%h/.config/deskpresence/light-hook {},%h/.config/deskpresence/emotune-hook {}"
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
